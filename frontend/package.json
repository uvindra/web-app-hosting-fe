{
  "private": true,
  "name": "@wso2/web-app-hosting-fe",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --open /dev-login",
    "dev:local": "vite --mode openchoreo",
    "build": "vite build",
    "build:check": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "preview": "vite preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:e2e": "dotenv -e .env.test -- playwright test",
    "test:e2e:ui": "dotenv -e .env.test -- playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.20",
    "@wso2/oxygen-ui": "^0.8.0",
    "@wso2/oxygen-ui-charts-react": "^0.8.3",
    "@wso2/oxygen-ui-icons-react": "^0.9.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-router": "7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-basic-ssl": "^2.2.0",
    "@vitejs/plugin-react-swc": "4.2.0",
    "@vitest/ui": "^4.1.9",
    "dotenv-cli": "^8.0.0",
    "eslint": "9.12.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.4.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "6.0.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.1.12",
    "vitest": "^4.1.9"
  }
}
