# Web App Hosting autoscaling Trait `web-app-hosting-hpa` (P1).
#
# Modelled on the upstream OpenChoreo 1.3.0 ClusterTrait `horizontal-pod-autoscaler`, except:
#   - everything is per environment (ReleaseBinding traitEnvironmentConfigs), because the console sets
#     the bounds and targets per environment;
#   - CPU and/or memory utilization targets (the WSO2 Cloud ClusterTrait is CPU-only);
#   - disabled by default: the BFF attaches it to every track Component (instance `hpa`) and enables it
#     per environment;
#   - maxReplicas is capped at 5, like the ComponentType's fixed replicas.
# While enabled it removes the Deployment's spec.replicas so the HPA alone owns the replica count.
#
# Rendered by the BFF with Go text/template using double-square-bracket delimiters.
apiVersion: openchoreo.dev/v1alpha1
kind: Trait
metadata:
  name: web-app-hosting-hpa
  annotations:
    openchoreo.dev/display-name: Web App Hosting autoscaler
    openchoreo.dev/description: Horizontal pod autoscaling on CPU and/or memory utilization
    web-app-hosting.wso2.com/ct-version: "[[ .Version ]]"
  labels:
    openchoreo.dev/name: web-app-hosting-hpa
spec:
  environmentConfigs:
    openAPIV3Schema:
      type: object
      properties:
        enabled:
          type: boolean
          default: false
        minReplicas:
          type: integer
          default: 1
          minimum: 1
          maximum: 5
        maxReplicas:
          type: integer
          default: 3
          minimum: 1
          maximum: 5
        # Average utilization targets, as a percentage of the container's request. At least one is
        # required while enabled.
        cpuUtilization:
          type: integer
          minimum: 1
          maximum: 100
        memoryUtilization:
          type: integer
          minimum: 1
          maximum: 100
  validations:
    - rule: '${!environmentConfigs.enabled || environmentConfigs.maxReplicas >= environmentConfigs.minReplicas}'
      message: maxReplicas must be greater than or equal to minReplicas.
    - rule: '${!environmentConfigs.enabled || has(environmentConfigs.cpuUtilization) || has(environmentConfigs.memoryUtilization)}'
      message: Autoscaling needs a CPU or a memory utilization target.
  creates:
    - includeWhen: '${environmentConfigs.enabled}'
      template:
        apiVersion: autoscaling/v2
        kind: HorizontalPodAutoscaler
        metadata:
          name: '${metadata.name}-${trait.instanceName}'
          namespace: '${metadata.namespace}'
          labels: '${metadata.labels}'
        spec:
          scaleTargetRef:
            apiVersion: apps/v1
            kind: Deployment
            name: '${metadata.name}'
          minReplicas: '${environmentConfigs.minReplicas}'
          maxReplicas: '${environmentConfigs.maxReplicas}'
          metrics: |
            ${(has(environmentConfigs.cpuUtilization) ? [{"type": "Resource", "resource": {"name": "cpu", "target": {"type": "Utilization", "averageUtilization": environmentConfigs.cpuUtilization}}}] : [])
              + (has(environmentConfigs.memoryUtilization) ? [{"type": "Resource", "resource": {"name": "memory", "target": {"type": "Utilization", "averageUtilization": environmentConfigs.memoryUtilization}}}] : [])}
  patches:
    - target:
        group: apps
        version: v1
        kind: Deployment
        where: '${environmentConfigs.enabled}'
      operations:
        - op: remove
          path: /spec/replicas
