# Web App Hosting BFF — local OpenChoreo (k3d-openchoreo) target.
# Load with: set -a; . dev/local.env; set +a   (see the repo README)
TARGET=openchoreo
PORT=9090
BASE_PATH=/webapp-hosting/api/v1
CORS_ALLOWED_ORIGINS=https://localhost:3000
LOG_LEVEL=info

# Inbound JWTs from local ThunderID (AUTH_MODE=dev skips validation and uses the
# BFF client for everything — only for the console's /dev-login).
AUTH_MODE=jwt
OIDC_ISSUER=http://thunder.openchoreo.localhost:8080
OIDC_JWKS_URL=http://thunder.openchoreo.localhost:8080/oauth2/jwks

# BFF service identity (registered by dev/setup-local-openchoreo.sh).
OAUTH_TOKEN_URL=http://thunder.openchoreo.localhost:8080/oauth2/token
OAUTH_CLIENT_ID=web-app-hosting-bff-local
OAUTH_CLIENT_SECRET=web-app-hosting-bff-local-secret

OC_API_URL=http://api.openchoreo.localhost:8080
OC_NAMESPACE=default
LOCAL_ORG_HANDLE=default
OBSERVER_URL=http://observer.openchoreo.localhost:11080
SECRET_TARGET_PLANE_KIND=ClusterDataPlane
SECRET_TARGET_PLANE_NAME=default
# Optional: raises the GitHub API rate limit for public-repo branch/commit reads.
# GITHUB_TOKEN=
# Plan every local org is on (no billing service locally): paid | free — to try P1 feature gating.
LOCAL_PLAN=paid
